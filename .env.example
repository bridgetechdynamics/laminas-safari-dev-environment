COMPOSE_PROJECT_NAME=laminas-safari-dev

# Editable source image is built locally. Image mode requires a full immutable tag.
APP_IMAGE=laminas-safari-dev:local
APP_HTTP_PORT=8080
APPLICATION_ENV=development
DEMO_MODE=1
APP_BASE_PATH=/

DB_HOST=db
DB_NAME=horsesns_safari
DB_USER=horsesns_safari
DB_PASSWORD=local-development-password
DB_ROOT_PASSWORD=local-development-root-password

# Development SMTP only. Leave blank to disable outgoing email in local work.
EMAIL_ADDRESS=
EMAIL_PASSWORD=
EMAIL_NAME=Safari Run Local
EMAIL_SERVER_NAME=
EMAIL_SERVER_HOST=
EMAIL_SERVER_PORT=465
EMAIL_SERVER_ENCRYPTION=ssl
CORPORATE_EMAIL_ADDRESS=
CORPORATE_EMAIL_NAME=Safari Run Local

# CAPTCHA test credentials only.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Local payment behavior must remain mocked.
MERCURY_MODE=mock
SECURE_BASE_URL=http://localhost:8080
MERCURY_CHECKOUT_FRAME=
MERCURY_SITE=
MERCURY_TRANS_SITE=

